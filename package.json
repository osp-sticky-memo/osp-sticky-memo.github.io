{
  "name": "dingdong-memo",
  "productName": "딩동메모",
  "version": "0.1.13",
  "description": "시간을 정해두면 딩동 알림이 오는 스티커형 메모",
  "author": "오상플레이",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --publish never"
  },
  "devDependencies": {
    "electron": "^45.2.3",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "com.ohsang.util.dingdongmemo",
    "productName": "딩동메모",
    "copyright": "© 2026 오상플레이",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "compression": "maximum",
    "publish": [
      {
        "provider": "github",
        "owner": "osp-sticky-memo",
        "repo": "osp-sticky-memo.github.io",
        "releaseType": "release"
      }
    ],
    "electronLanguages": [
      "ko",
      "en-US"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico",
      "artifactName": "DingDongMemo-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "딩동메모"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/osp-sticky-memo/osp-sticky-memo.github.io.git"
  },
  "homepage": "https://osp-sticky-memo.github.io/",
  "dependencies": {
    "electron-updater": "^6.8.11"
  }
}
